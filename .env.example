# Copy this file to .env to override billing-client settings in docker compose.
# Every variable is optional: leave it commented out to use the development default.
# Don't leave a variable empty — an empty value replaces the default.

# Secret used to sign JWTs (64+ characters). Required outside local development.
# JWT_SECRET=replace-with-a-long-random-string-of-at-least-sixty-four-characters

# Initial ADMIN user, created on first startup if no admin exists yet.
# ADMIN_EMAIL=admin@billing.com
# ADMIN_PASSWORD=change-me-please
